# ── Copy this file to .env and fill in your values ─────────────────────────

# Django secret key – generate a new one for every deployment
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=change-me-to-a-long-random-string

# Set to False in production
DEBUG=True

# Comma-separated list of hosts/domains Django will serve (e.g. localhost,127.0.0.1)
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# ── Neon (serverless Postgres) ────────────────────────────────────────────
# Format: postgres://USER:PASSWORD@HOST/DBNAME?sslmode=require
# Get this from your Neon project dashboard → Connection Details
DATABASE_URL=postgres://user:password@ep-example.us-east-2.aws.neon.tech/neondb?sslmode=require

# ── Field-level encryption keys (Fernet / MultiFernet) ───────────────────
# Supports key rotation: set FIELD_ENCRYPTION_KEYS to a comma-separated list
# of keys (new key first).  New key is used for encryption; all keys can
# decrypt.  After rotation, run: python manage.py reencrypt_fields
# See docs/runbook.md §2 for the full rotation + key-escrow procedure.
#
# Generate a key:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#
# Single key (legacy):
FIELD_ENCRYPTION_KEY=change-me-to-a-fernet-key
#
# Multi-key rotation (prepend new key, keep old as fallback):
# FIELD_ENCRYPTION_KEYS=new-key,old-key

# ── Blind-index key for encrypted-field search (HMAC-SHA256) ─────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# Used to build searchable hashes of patient name and national_id without
# storing plaintext. Keep this separate from FIELD_ENCRYPTION_KEY.
BLIND_INDEX_KEY=change-me-to-a-64-char-hex-string

# ── MFA enforcement ───────────────────────────────────────────────────────
# True  → clinical/admin roles MUST complete TOTP each session
# False → TOTP available but not enforced (good for DEBUG/demo)
# Omit  → automatically True when DEBUG=False, False when DEBUG=True
# MFA_ENFORCED=True

# ── Brute-force lockout (django-axes) ────────────────────────────────────
# Lock account after this many failed login attempts (default: 5)
# AXES_FAILURE_LIMIT=5

# ── Trusted-device MFA window ────────────────────────────────────────────
# Number of hours before MFA is re-prompted on the same device.
# Default: 8 hours (one clinical shift). Set to 0 to always prompt.
# MFA_TRUSTED_DEVICE_HOURS=8

# ── FHIR base URL ────────────────────────────────────────────────────────
# Base URL for FHIR resource references. Update to your deployment URL.
# FHIR_BASE_URL=https://emr.example.com/fhir

# ── Logging ───────────────────────────────────────────────────────────────
# LOG_LEVEL=WARNING

# ── Shared cache (Redis) ──────────────────────────────────────────────────
# Required for correct multi-worker rate limiting in production.
# Omit (or leave empty) for local dev — falls back to per-process LocMemCache.
# Format: redis://HOST:PORT/DB  (or rediss:// for TLS)
# REDIS_URL=redis://localhost:6379/0

# ── Demo seeding (entrypoint) ─────────────────────────────────────────────
# Set to 'true' ONLY for local demo / development environments.
# Creates hospitals, staff, and patients with the public password Demo@123456.
# NEVER set this in production — leave unset or set to 'false'.
# SEED_DEMO=true
